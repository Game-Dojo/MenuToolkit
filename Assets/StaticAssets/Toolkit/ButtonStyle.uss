:root {
}

.primary-button {
    background-image: url("project://database/Assets/StaticAssets/UI/Border/panel-border-000.png?fileID=2800000&guid=6d2ceaa0c0ddc3a4aba18adc3546c31e&type=3#panel-border-000");
    background-color: rgba(188, 188, 188, 0);
    -unity-slice-left: 24;
    -unity-slice-top: 24;
    -unity-slice-right: 24;
    -unity-slice-bottom: 24;
    color: rgb(255, 255, 255);
    position: relative;
    width: auto;
    top: auto;
    left: auto;
    bottom: auto;
    right: auto;
    -unity-font-definition: url("project://database/Assets/StaticAssets/Font/Lora-Italic-VariableFont_wght.ttf?fileID=12800000&guid=bbc2891b3dc7a454eaeb315fda54e605&type=3#Lora-Italic-VariableFont_wght");
    padding-top: 20px;
    padding-right: 16px;
    padding-bottom: 20px;
    padding-left: 16px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    height: 100px;
    font-size: 32px;
    text-overflow: ellipsis;
    white-space: normal;
    -unity-font-style: normal;
    min-height: 100px;
    min-width: 400px;
    transition-duration: 0.2s;
}

.primary-button:hover {
    background-image: url("project://database/Assets/StaticAssets/UI/Border/panel-border-000.png?fileID=2800000&guid=6d2ceaa0c0ddc3a4aba18adc3546c31e&type=3#panel-border-000");
    background-color: rgba(188, 188, 188, 0);
    -unity-slice-left: 24;
    -unity-slice-top: 24;
    -unity-slice-right: 24;
    -unity-slice-bottom: 24;
    color: var(--accent);
    position: relative;
    width: auto;
    top: auto;
    left: auto;
    bottom: auto;
    right: auto;
    -unity-font-definition: url("project://database/Assets/StaticAssets/Font/Lora-Italic-VariableFont_wght.ttf?fileID=12800000&guid=bbc2891b3dc7a454eaeb315fda54e605&type=3#Lora-Italic-VariableFont_wght");
    padding-top: 20px;
    padding-right: 16px;
    padding-bottom: 20px;
    padding-left: 16px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    height: 100px;
    font-size: 32px;
    text-overflow: ellipsis;
    white-space: normal;
    -unity-font-style: normal;
    min-height: 100px;
    min-width: 400px;
    transition-duration: 0.2s;
    scale: 1.05 1.05 1.05;
}

.primary-button:active {
    background-image: url("project://database/Assets/StaticAssets/UI/Border/panel-border-000.png?fileID=2800000&guid=6d2ceaa0c0ddc3a4aba18adc3546c31e&type=3#panel-border-000");
    background-color: rgba(188, 188, 188, 0);
    -unity-slice-left: 24;
    -unity-slice-top: 24;
    -unity-slice-right: 24;
    -unity-slice-bottom: 24;
    color: rgb(255, 255, 255);
    position: relative;
    width: auto;
    top: auto;
    left: auto;
    bottom: auto;
    right: auto;
    -unity-font-definition: url("project://database/Assets/StaticAssets/Font/Lora-Italic-VariableFont_wght.ttf?fileID=12800000&guid=bbc2891b3dc7a454eaeb315fda54e605&type=3#Lora-Italic-VariableFont_wght");
    padding-top: 20px;
    padding-right: 16px;
    padding-bottom: 20px;
    padding-left: 16px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    height: 100px;
    font-size: 32px;
    text-overflow: ellipsis;
    white-space: normal;
    -unity-font-style: normal;
    min-height: 100px;
    min-width: 400px;
    transition-duration: 0.2s;
    opacity: 0.52;
    scale: 0.95 0.95;
}
